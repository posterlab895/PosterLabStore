rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders: allow all authenticated operations
    match /orders/{orderId} {
      allow read, write: if true;
    }
    // Products: allow all access (admin writes via admin panel)
    match /products/{productId} {
      allow read, write: if true;
    }
    // Coupons: allow all access (admin writes via admin panel)
    match /coupons/{couponCode} {
      allow read, write: if true;
    }
    // Users: owner access based on email
    match /users/{email} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}